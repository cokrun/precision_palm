# Flask Server Configuration
FLASK_ENV=production
PORT=8080

# Google Cloud Platform Governance
GOOGLE_CLOUD_PROJECT=palm-project-xxxxx
GCP_REGION=asia-southeast2
GCS_SPATIAL_BUCKET=palm-spatial-assets-xxxxx

# BigQuery Enterprise Data Warehouse
BIGQUERY_DATASET=precision_palm_dw
BIGQUERY_TABLE_AUDIT=audit_events
BIGQUERY_TABLE_LOGS=system_logs

# Gemini Multimodal AI Engine
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash

# Application Base URL & Media Routing
APP_BASE_URL=https://your-service-domain.run.app
