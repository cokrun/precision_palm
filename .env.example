# =========================================================================
# PRECISION PALM CLOUD - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin berkas ini menjadi .env lalu isi dengan kredensial aktif Anda
# =========================================================================

# Flask Secret Key
FLASK_SECRET_KEY=precision_palm_enterprise_secret_2026
FLASK_ENV=production

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=precision-palm-demo
GCP_REGION=asia-southeast2
VERTEX_AI_ENABLED=true
VERTEX_MODEL_NAME=gemini-2.5-flash

# Google Gemini API Key (Untuk pengujian lokal / standalone mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine (Opsional untuk cloud tile rendering)
# GEE_SERVICE_ACCOUNT=precision-palm-gee@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_FILE=gcp-service-account-key.json

# Port Binding
PORT=8080
